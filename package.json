{
  "name": "banquet-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bm/web",
    "build": "npm run build -w @bm/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check:functions": "npx -y deno@2 check --node-modules-dir=none supabase/functions/*/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
